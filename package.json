{
  "name": "thinkmakestart-ui",
  "version": "1.0.0",
  "description": "ThinkMakeStart desktop application",
  "main": "./out/main/index.js",
  "author": "liam.greissing@gmail.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:python": "node scripts/build-python.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build:python && npm run build && electron-builder --dir",
    "build:win": "npm run build:python -- --platform win32 && npm run build && electron-builder --win",
    "build:mac": "npm run build:python -- --platform darwin && npm run build && electron-builder --mac",
    "build:linux": "npm run build:python -- --platform linux && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.46.0",
    "next-themes": "^0.4.6",
    "occt-import-js": "^0.0.23",
    "openai": "^7.17.0",
    "pcb-stackup": "^4.2.8",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "whats-that-gerber": "^4.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
